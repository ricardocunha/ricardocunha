{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ricardocunha-profile",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Served at https://mcp.ricardocunha.dev. The zone ricardocunha.dev must be
  // active in this Cloudflare account; the deploy creates the DNS record and certificate.
  "routes": [{ "pattern": "mcp.ricardocunha.dev", "custom_domain": true }],
  "observability": { "enabled": true },

  // Usage counters: one SQLite-backed Durable Object (works on the free plan).
  // No ID to fill in: the namespace is created by the migration on first deploy.
  "durable_objects": {
    "bindings": [{ "name": "COUNTERS", "class_name": "Counters" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counters"] }],

  // Workers Rate Limiting binding. namespace_id is any integer you choose,
  // unique within your account; nothing has to be created beforehand.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],

  "vars": {
    // "*" accepts any Origin (public, read-only data, no credentials).
    // Set a comma-separated list of origins to restrict browser callers.
    "ALLOWED_ORIGINS": "*",
    "STATS_CACHE_SECONDS": "60"
  }
}
